{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vita: Configure device",
      "type": "process",
      "command": "py",
      "args": [
        "-3",
        "${workspaceFolder}/tools/session.py",
        "configure",
        "--vita-ip",
        "${input:vitaIp}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vita: Validate local setup",
      "type": "process",
      "command": "py",
      "args": [
        "-3",
        "${workspaceFolder}/tools/session.py",
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vita: Build demo",
      "type": "process",
      "command": "py",
      "args": [
        "-3",
        "${workspaceFolder}/tools/session.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vita: Build, deploy, and prepare debug",
      "type": "process",
      "command": "py",
      "args": [
        "-3",
        "${workspaceFolder}/tools/session.py",
        "prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vita: Stop demo",
      "type": "process",
      "command": "py",
      "args": [
        "-3",
        "${workspaceFolder}/tools/session.py",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ],
  "inputs": [
    {
      "id": "vitaIp",
      "type": "promptString",
      "description": "IPv4 address shown by your PS Vita network settings"
    }
  ]
}
